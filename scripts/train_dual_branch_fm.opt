# Dual-branch FM training defaults loaded by `scripts/train.sh`.
# Override any value from the shell, for example:
#   GPU_ID=1 BATCH_SIZE=8 LR=2e-4 scripts/train.sh

# Experiment/runtime
OPT_PROJECT_NAME="dual-branch-fm"
OPT_LOG_WITH="wandb"
OPT_MIXED_PRECISION="bf16"
OPT_SEED="42"
OPT_RESUME_CHECKPOINT=""

# Optimizer / schedule
OPT_MAX_STEPS="10000"
OPT_SAVE_EVERY="1000"
OPT_LOG_EVERY="20"
OPT_PRINT_EVERY="50"
OPT_GRAD_ACCUM_STEPS="1"
OPT_LR="1.5e-4"
OPT_WEIGHT_DECAY="1e-4"
OPT_WARMUP_STEPS="300"
OPT_MAX_GRAD_NORM="1.0"

# Dataloader / caching
OPT_BATCH_SIZE="4"
OPT_NUM_WORKERS="12"
OPT_DATASET_CACHE_SEQUENCES="2"
OPT_INDEX_PROGRESS_EVERY="10"
OPT_PREFETCH_FACTOR="2"
OPT_CACHE_RGB="1"
OPT_TRAIN_MAX_SEQUENCES="0"

# Input / model
OPT_CLIP_LENGTH="8"
OPT_CLIP_STRIDE="4"
OPT_IMAGE_HEIGHT="256"
OPT_IMAGE_WIDTH="256"
OPT_PATCH_SIZE="16"
OPT_HIDDEN_DIM="384"
OPT_DEPTH="6"
OPT_NUM_HEADS="6"
OPT_MLP_RATIO="3.0"
OPT_DROPOUT="0.0"
OPT_VIDEO_CHANNELS="6"
OPT_BACKGROUND_VALUE="1.0"
OPT_HUMAN_GAUSSIAN_SOURCE="smpl_mesh"

# HOI state
OPT_NUM_HUMAN_GAUSSIANS="750"
OPT_NUM_OBJECT_GAUSSIANS="750"
OPT_NUM_JOINTS="22"
OPT_CONTACT_DIM="4"

# Curriculum / staged optimization
OPT_CURRICULUM_FUSION_START_RATIO="0.2"
OPT_CURRICULUM_FULL_START_RATIO="0.6"
OPT_FREEZE_VIDEO_BACKBONE="1"
OPT_VIDEO_UNFREEZE_START_RATIO="-1.0"
OPT_VIDEO_STAGE2_NUM_TOP_BLOCKS="2"
